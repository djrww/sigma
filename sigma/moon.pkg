import {
  "sigma/supermatrix/core",
  "sigma/supermatrix/fga",
  "sigma/supermatrix/latt",
  "sigma/supermatrix/spec",
  "sigma/supermatrix/curves",
  "sigma/supermatrix/padic",
  "sigma/supermatrix/synth",
  "sigma/supermatrix/mat2",
  "sigma/supermatrix/proof/synth" @psynth,
  "sigma/supermatrix/proof/mat2" @pmat2,
  "sigma/supermatrix/proof/fga_snf" @pfga,
  "sigma/supermatrix/proof/latt" @platt,
  "sigma/supermatrix/proof/spec" @pspec,
  "sigma/supermatrix/proof/curves_padic" @pcp,
  "sigma/supermatrix/proof/sigma" @psigma,
}

rule(name: "sigmac", command: "python3 tools/sigmac.py $input $output")

dev_build(
  rule: "sigmac",
  input: "crypto_suite.sigma",
  output: "generated_suite.mbt",
)
