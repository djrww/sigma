///|
/// 邏輯側（.mbtp）：族 D（D1–D6）、H9 與 `spec` 套件（雙向 FFT、卷積定理、循環算子對角化、
/// 伴隨映射、辛雙環 SᵀJS=J、超跡超交換子消沒、塊三角 Berezinian、二次與三次極化恆等式）
/// 之形式化規格與引理。
///
/// 註記：任意 N=2^k 遞迴奇偶分治陣列 `spec::fft`/`ifft` 與模 p 矩陣求逆 Береzinian
/// 見最終報告「組合爆炸演算法（ALG-CE-06）」與「超時定理（T-TO-05）」章節。

/// --- 1. D1/H9：4 點雙向傅立葉變換（Radix-2 蝶形網絡）往返互逆定理 F₄* · F₄(x) = 4·x ---

pub predicate dft4_roundtrip_ok(
  x0 : Int,
  x1 : Int,
  x2 : Int,
  x3 : Int,
  r : (Int, Int, Int, Int),
) {
  match r {
    (y0, y1, y2, y3) =>
      y0 == 4 * x0 &&
      y1 == 4 * x1 &&
      y2 == 4 * x2 &&
      y3 == 4 * x3
  }
}

/// --- 2. D2：卷積定理 IFFT(FFT(a) ⊙ FFT(b)) == 2 · (a *_cyc b) ---

pub predicate conv2_theorem_ok(
  a0 : Int,
  a1 : Int,
  b0 : Int,
  b1 : Int,
  r : ((Int, Int), (Int, Int)),
) {
  match r {
    ((fft_c0, fft_c1), (naive_c0, naive_c1)) =>
      naive_c0 == a0 * b0 + a1 * b1 &&
      naive_c1 == a0 * b1 + a1 * b0 &&
      fft_c0 == 2 * naive_c0 &&
      fft_c1 == 2 * naive_c1
  }
}

/// --- 3. D3/H9：循環算子雙向對角化 F₂ · Circ(c₀, c₁) = diag(c₀+c₁, c₀-c₁) · F₂ ---

pub predicate circ_eigen_diag2_ok(
  c0 : Int,
  c1 : Int,
  r : ((Int, Int, Int, Int), (Int, Int, Int, Int)),
) {
  match r {
    ((l11, l12, l21, l22), (r11, r12, r21, r22)) =>
      l11 == r11 &&
      l12 == r12 &&
      l21 == r21 &&
      l22 == r22 &&
      l11 == c0 + c1 &&
      l22 == -(c0 - c1)
  }
}

/// --- 4–5. D4/H9：伴隨映射內積恆等式 ⟨Ax, y⟩ == ⟨x, Aᵀy⟩（2D 與 3D）---

pub predicate adjoint2_ok(
  a11 : Int,
  a12 : Int,
  a21 : Int,
  a22 : Int,
  x1 : Int,
  x2 : Int,
  y1 : Int,
  y2 : Int,
  r : (Int, Int),
) {
  match r {
    (lhs, rhs) =>
      lhs == (a11 * x1 + a12 * x2) * y1 + (a21 * x1 + a22 * x2) * y2 &&
      rhs == x1 * (a11 * y1 + a21 * y2) + x2 * (a12 * y1 + a22 * y2) &&
      lhs == rhs
  }
}

pub predicate adjoint3_ok(
  d1 : Int,
  d2 : Int,
  d3 : Int,
  s12 : Int,
  s23 : Int,
  x1 : Int,
  x2 : Int,
  x3 : Int,
  y1 : Int,
  y2 : Int,
  y3 : Int,
  r : (Int, Int),
) {
  match r {
    (lhs, rhs) =>
      lhs == (d1 * x1 + s12 * x2) * y1 + (d2 * x2 + s23 * x3) * y2 + d3 * x3 * y3 &&
      rhs == x1 * (d1 * y1) + x2 * (s12 * y1 + d2 * y2) + x3 * (s23 * y2 + d3 * y3) &&
      lhs == rhs
  }
}

/// --- 6–7. D4/H9：辛雙環保守辛形式 Sᵀ J S = J 與辛對合 J² = -I ---

pub predicate symplectic_shear_ok(t : Int, r : (Int, Int, Int, Int)) {
  match r {
    (p11, p12, p21, p22) =>
      p11 == 1 &&
      p12 == 0 &&
      p21 == t + (-t) &&
      p22 == 1 &&
      p21 == 0
  }
}

pub predicate symplectic_j2_involution_ok(r : (Int, Int, Int, Int, Int, Int)) {
  match r {
    (j2_11, j2_12, j2_21, j2_22, sym12, sym21) =>
      j2_11 == -1 &&
      j2_12 == 0 &&
      j2_21 == 0 &&
      j2_22 == -1 &&
      sym12 == 0 &&
      sym21 == 0
  }
}

/// --- 8–9. D5/H9：超矩陣超跡在超交換子（偶交換子與奇反交換子）上恆為 0 ---

pub predicate supertrace_even_comm_ok(
  a11 : Int,
  a12 : Int,
  a21 : Int,
  a22 : Int,
  b11 : Int,
  b12 : Int,
  b21 : Int,
  b22 : Int,
  r : Int,
) {
  r == 0 &&
  ((a11 * b11 + a12 * b21) + (a21 * b12 + a22 * b22)) -
    ((b11 * a11 + b12 * a21) + (b21 * a12 + b22 * a22)) == r
}

pub predicate supertrace_odd_anticomm_ok(
  b1 : Int,
  c1 : Int,
  b2 : Int,
  c2 : Int,
  r : (Int, Int, Int),
) {
  match r {
    (even_top, even_bot, str_val) =>
      even_top == b1 * c2 + b2 * c1 &&
      even_bot == c1 * b2 + c2 * b1 &&
      str_val == even_top - even_bot &&
      str_val == 0
  }
}

/// --- 10. D5：塊三角超矩陣 Berezinian 乘法性核 ---

pub predicate ber_block_tri_ok(
  a1 : Int,
  d1 : Int,
  a2 : Int,
  d2 : Int,
  r : ((Int, Int), (Int, Int)),
) {
  match r {
    ((num_mn, den_mn), (num_sep, den_sep)) =>
      num_mn == a1 * a2 &&
      den_mn == d1 * d2 &&
      num_mn == num_sep &&
      den_mn == den_sep
  }
}

/// --- 11. D6：二次型極化恆等式 Q(x+y) - Q(x) - Q(y) = 2·B(x,y) ---

pub predicate polarization_quad2_ok(
  a : Int,
  b : Int,
  c : Int,
  x1 : Int,
  x2 : Int,
  y1 : Int,
  y2 : Int,
  r : (Int, Int),
) {
  match r {
    (lhs_diff, rhs_2b) =>
      rhs_2b == 2 * (a * x1 * y1 + b * (x1 * y2 + x2 * y1) + c * x2 * y2) &&
      lhs_diff == rhs_2b
  }
}

/// --- 12. D6：三次型容斥極化恆等式 Σ(-1)^{3-|S|} P(Σ u_i) = 6·u·v·w ---

pub predicate polarization_cubic_ok(
  u : Int,
  v : Int,
  w : Int,
  r : (Int, Int, Int),
) {
  match r {
    (inc_excl, six_uvw, diag_uuu) =>
      six_uvw == 6 * u * v * w &&
      inc_excl == six_uvw &&
      diag_uuu == 6 * u * u * u
  }
}

/// --- 純代數引理 ---

pub predicate cubic_polar_scalar_ok(u : Int, v : Int, w : Int) {
  (u + v + w) * (u + v + w) * (u + v + w) -
    (u + v) * (u + v) * (u + v) -
    (u + w) * (u + w) * (u + w) -
    (v + w) * (v + w) * (v + w) +
    u * u * u +
    v * v * v +
    w * w * w ==
    6 * u * v * w
}

pub lemma lemma_cubic_polarization_scalar(u : Int, v : Int, w : Int) where {
  proof_ensure: cubic_polar_scalar_ok(u, v, w),
} {}

pub predicate supercomm_odd_scalar_ok(b1 : Int, c1 : Int, b2 : Int, c2 : Int) {
  (b1 * c2 + b2 * c1) - (c1 * b2 + c2 * b1) == 0
}

pub lemma lemma_supercommutator_odd_trace(
  b1 : Int,
  c1 : Int,
  b2 : Int,
  c2 : Int,
) where {
  proof_ensure: supercomm_odd_scalar_ok(b1, c1, b2, c2),
} {}
